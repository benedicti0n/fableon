{
  "name": "fableon",
  "version": "0.0.0",
  "private": true,
  "description": "Fableon — an AI-native studio for painterly illustrated animation.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @fableon/web dev",
    "build": "pnpm --filter @fableon/web build",
    "start": "pnpm --filter @fableon/web start",
    "lint": "eslint .",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
